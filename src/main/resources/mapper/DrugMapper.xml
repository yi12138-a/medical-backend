<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.qst.medical.mapper.DrugMapper">

    <!--多对多嵌套查询：查询药品时，一并查询该药品id对应的所有药店，此方法可以使用pagehelper，但影响性能-->
    <resultMap id="getAllDrugs" type="com.qst.medical.model.DrugModel">
        <id property="drugId" column="drug_id"/>
        <result property="drugName" column="drug_name"/>
        <result property="drugInfo" column="drug_info"/>
        <result property="drugEffect" column="drug_effect"/>
        <result property="drugImg" column="drug_img"/>
        <result property="drugPublisher" column="publisher"/>
        <result property="createtime" column="createtime"/>
        <result property="updatetime" column="updatetime"/>
        <collection property="drugSales" ofType="com.qst.medical.model.SaleModel"
                    select="getWithSale" column="drug_id">
            <id property="saleId" column="sale_id"/>
            <result property="saleName" column="sale_name"/>
        </collection>
    </resultMap>

    <!--药品主查询，查询所有的药品信息，name 不为空时按药品名称模糊查询-->
    <select id="getAllDrug" resultMap="getAllDrugs">
        select drug_id, drug_name, drug_info, drug_effect, drug_img,
               createtime, updatetime, publisher
        from drug
        <where>
            <if test="name != null and name != ''">
                <bind name="drugName" value="'%' + name + '%'"/>
                drug_name LIKE #{drugName}
            </if>
        </where>
    </select>

    <!--药品子查询，查询药品id对应的所有药店-->
    <select id="getWithSale" resultType="com.qst.medical.model.SaleModel">
        select s.sale_id, s.sale_name
        from sale s
        left join drug_sale ds on s.sale_id = ds.sale_id
        where ds.drug_id = #{drugId}
    </select>

    <!--新增药品信息-->
    <insert id="saveDrug" parameterType="com.qst.medical.param.DrugParam"
            keyProperty="drugId" useGeneratedKeys="true">
        insert into drug(drug_name, drug_info, drug_effect, drug_img, createtime, updatetime, publisher)
        values(#{drugName}, #{drugInfo}, #{drugEffect}, #{drugImg}, #{createtime}, #{updatetime}, #{drugPublisher})
    </insert>

    <!--根据id更新药品信息（创建时间不允许被前端覆盖，故不在 set 中更新 createtime）-->
    <update id="updateDrugById">
        update drug
        set drug_name=#{drugName},
            drug_info=#{drugInfo},
            drug_effect=#{drugEffect},
            drug_img=#{drugImg},
            publisher=#{drugPublisher},
            updatetime=#{updatetime}
        where drug_id=#{drugId}
    </update>

    <!--插入药品对应的售卖地点（saleIds 为数组，使用 foreach 循环插入多行）-->
    <insert id="insertSalePlace">
        insert into drug_sale(drug_id, sale_id) values
        <foreach collection="saleIds" item="item" separator=",">
            (#{drugId}, #{item})
        </foreach>
    </insert>

    <!--根据药品id删除对应的售卖地点-->
    <delete id="deleteSaleByDrugId">
        delete from drug_sale where drug_id=#{drugId}
    </delete>

    <!--根据药品id删除对应药品-->
    <delete id="deleteDrugById">
        delete from drug where drug_id=#{drugId}
    </delete>

</mapper>
