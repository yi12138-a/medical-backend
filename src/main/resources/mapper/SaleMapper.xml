<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.qst.medical.mapper.SaleMapper">

    <!--查询所有的销售地点信息,name不为空则模糊查询-->
    <select id="getAllSale" resultType="com.qst.medical.domain.Sale">
        select *
        from sale
        <if test="name != null and name != ''">
            <where>
                <bind name="saleName" value="'%' + name + '%'"/>
                sale_name LIKE #{saleName}
            </where>
        </if>
    </select>

    <!--根据id查找一个销售地点信息-->
    <select id="getSaleById" resultType="com.qst.medical.domain.Sale">
        select *
        from sale
        where sale_id = #{id} limit 1
    </select>

    <!--添加一个销售地点信息-->
    <insert id="saveSale" parameterType="com.qst.medical.entity.SaleEntity">
        <selectKey resultType="java.lang.Long" order="AFTER" keyProperty="total">
            select COUNT(*) from sale
        </selectKey>
        insert into sale(sale_name,sale_phone,updatetime,createtime,lng,lat,address)
        values (#{saleName},#{salePhone},#{updatetime},#{createtime},#{lng},#{lat},#{address})
    </insert>

    <!--根据id删除销售地点信息-->
    <delete id="deleteSaleById">
        delete
        from sale
        where sale_id = #{id}
    </delete>

    <!--根据id更新销售地点信息：经纬度和地址为空时保留原值，只更新确实传入的字段-->
    <update id="updateSaleById">
        update sale
        <set>
            sale_name = #{saleName},
            sale_phone = #{salePhone},
            updatetime = #{updatetime},
            <if test="lng != null">lng = #{lng},</if>
            <if test="lat != null">lat = #{lat},</if>
            <if test="address != null and address != ''">address = #{address},</if>
        </set>
        where sale_id = #{saleId}
    </update>

</mapper>
